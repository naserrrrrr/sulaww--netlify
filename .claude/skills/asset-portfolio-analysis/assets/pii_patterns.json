{
  "_comment": "Single source of truth for personal-data detection. Loaded by scripts/apa_common.py (Python re) and scripts/check_dashboard.mjs (JS RegExp). Patterns must be valid in both engines: ASCII digits only (callers translate Arabic-Indic digits first), fixed-width lookbehind only. Value 'level': block = must never appear in outputs; review = flagged for the analyst (e.g. a 10-digit number may be a deed or a national ID). header_tests are checked with apa_common.is_pii_header (raw and hamza/tatweel-folded pattern): plural person nouns are personal; counts («عدد الأيتام») and property words («أملاك») are not. Mobile numbers block only with a 0/+966/00966 prefix or the mobile grouping «5X XXX XXXX»; a bare 9-digit «5XXXXXXXX» is review level (it may be an amount or a plot number). A 10-digit [12]… number within 25 characters after هوية/سجل مدني/إقامة/ID/Iqama is a national ID and blocks.",
  "version": 4,
  "redaction": "<محجوب>",
  "digit_separators": "[\\s\\u00A0\\-.()/]",
  "header": {
    "flags": "i",
    "pattern": "جوال|هاتف|تلفون|تليفون|تواصل|اتصال|موبايل|واتس|ايميل|إيميل|بريد|mobile|phone|\\btel\\b|whatsapp|e-?mail|contact|اسم\\s*المشرف|المشرف|المسؤول\\s*عن|هوي[ةه]|(?:ال)?سجل\\s*(?:ال)?مدني|إقامة|اقامة|iqama|national\\s*id|\\bid\\s*(?:no|number)\\b|passport|جواز|\\biban\\b|ايبان|آيبان|حساب\\s*بنكي|(?:اسم\\s*)?(?:ال)?(?:مستأجر|مؤجر|مالك|مستفيد|يتيم|وكيل|مندوب|عميل|موظف)(?=\\s|$)|(?<![ء-ي])(?<!عدد\\s)(?:ال)?(?:مستأجرين|مستأجرون|ملاك|مستفيدين|مستفيدون|أيتام|موظفين|موظفون|عملاء|وكلاء|مندوبين)(?=\\s|$)|tenant|landlord|owner'?s?\\s*name|\\bowner\\b|lessee|guardian|beneficiar|orphan|ولي\\s*(?:ال)?أمر|(?<![ء-ي])(?:ال)?كفيل(?![ء-ي])"
  },
  "field_key": {
    "flags": "i",
    "pattern": "phone|mobile|supervisor|e-?mail|contact|whatsapp|iban|national_?id|iqama|passport|tenant|landlord|owner_?name|lessee|guardian|beneficiar|orphan|جوال|هاتف|مشرف|تواصل|اتصال|بريد|ايميل|إيميل|هوية|مستأجر|مستفيد"
  },
  "values": [
    {
      "kind": "mobile",
      "level": "block",
      "flags": "",
      "pattern": "(?<!\\d)(?:(?:\\+|00)[\\s\\u00A0]?9[\\s\\u00A0]?6[\\s\\u00A0]?6[\\s\\u00A0\\-.()/]{0,3}|0)[\\s\\u00A0\\-.()/]{0,3}5(?:[\\s\\u00A0\\-.()/]{0,3}\\d){8}(?!\\d)"
    },
    {
      "kind": "mobile",
      "level": "block",
      "flags": "",
      "pattern": "(?<![A-Za-z0-9\\-./,])5\\d[\\s\\u00A0\\-]\\d{3}[\\s\\u00A0\\-]\\d{4}(?![\\d.,])"
    },
    {
      "kind": "mobile_unprefixed",
      "level": "review",
      "flags": "",
      "pattern": "(?<![A-Za-z0-9\\-./,])5\\d{8}(?![\\d.,])"
    },
    {
      "kind": "landline",
      "level": "block",
      "flags": "",
      "pattern": "(?<!\\d)(?:(?:\\+|00)[\\s\\u00A0]?966[\\s\\u00A0\\-.()/]{0,3}|0)[\\s\\u00A0\\-.()/]{0,2}1[1-7](?:[\\s\\u00A0\\-.()/]{0,3}\\d){7}(?!\\d)"
    },
    {
      "kind": "email",
      "level": "block",
      "flags": "",
      "pattern": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}"
    },
    {
      "kind": "iban",
      "level": "block",
      "flags": "i",
      "pattern": "\\bSA\\d{2}(?:\\s?[A-Z0-9]){20}\\b"
    },
    {
      "kind": "national_id",
      "level": "block",
      "flags": "i",
      "pattern": "(?:هوي[ةه]|سجل[\\s\\u00A0]*(?:ال)?مدني|إقامة|اقامة|(?<![A-Za-z])(?:national[\\s\\u00A0_]*)?id(?![A-Za-z])|iqama)[^\\d]{0,25}(?<!\\d)[12]\\d{9}(?![\\d.,])"
    },
    {
      "kind": "national_id",
      "level": "review",
      "flags": "",
      "pattern": "(?<![\\d.,])[12]\\d{9}(?![\\d.,])"
    }
  ],
  "tests": {
    "must_match": [
      "0501234567",
      "050 123 4567",
      "(050) 123-4567",
      "050.123.4567",
      "+966 50 123 4567",
      "00966501234567",
      "011-4567890",
      "+966 11 456 7890",
      "٠٥٠١٢٣٤٥٦٧",
      "someone@example.com",
      "SA0380000000608010167519",
      "1012345678",
      "55 123 4567",
      "هوية المستأجر 1023456789",
      "رقم الهوية: ٢٠١٢٣٤٥٦٧٨",
      "Iqama 2123456789"
    ],
    "must_not_match": [
      "5,000,000",
      "2,375,000",
      "784512",
      "1410/5/12",
      "2025-12-02",
      "REG-5",
      "12.40%",
      "187320.5",
      "مشمول 8 من 11",
      "500 000 000",
      "512 345 678",
      "٥٠٠ ٠٠٠ ٠٠٠",
      "5/123/45678",
      "5.12345678",
      "REG-512345678",
      "قيمة الأرض حسب التقييم 500 000 000 ريال"
    ],
    "block_must_match": [
      "0551234567",
      "+966 55 123 4567",
      "55-123-4567",
      "هوية المستأجر 1023456789",
      "السجل المدني 1023456789"
    ],
    "block_must_not_match": [
      "1023456789",
      "512345678",
      "رقم الصك 1023456789"
    ]
  },
  "header_tests": {
    "must_match": [
      "اسم المستأجر",
      "اسم المستاجر",
      "اســم المستــأجر",
      "أسماء المستأجرين",
      "الملاك",
      "المستفيدين",
      "المستفيدون من الوقف",
      "الأيتام",
      "الموظفين",
      "العملاء",
      "رقم الجوال",
      "Tenant name",
      "IBAN",
      "Owner",
      "Lessee",
      "Guardian",
      "ولي الأمر",
      "الكفيل",
      "اسم الكفيل"
    ],
    "must_not_match": [
      "إدارة أملاك",
      "الأملاك الوقفية",
      "عدد الأيتام",
      "عدد المستفيدين",
      "اسم العقار",
      "الإيراد 2024",
      "نوع الأصل",
      "المساحة",
      "Ownership",
      "نوع الملكية",
      "إيراد الكفالات"
    ]
  }
}
